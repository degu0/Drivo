# Copie para .env e troque os valores: cp .env.example .env
# O docker-compose e o backend leem este arquivo.

# --- Banco de dados (usado pelo docker-compose) ---
# Evite na senha caracteres que quebram URLs (@ : / ? # % & +),
# porque ela também é usada dentro da DATABASE_URL.
POSTGRES_USER=drivo
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=drivo

# --- Conexão do Prisma ---
# Uso local, fora do Docker (porta 5433 = container do Postgres).
# No Docker, o compose sobrescreve com host "database" e porta 5432.
DATABASE_URL="postgresql://drivo:troque_esta_senha@localhost:5433/drivo?schema=public"

# --- Autenticação ---
# JWT_SECRET: mínimo de 32 caracteres. Gere um com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_aleatorio_com_32_ou_mais_caracteres
JWT_EXPIRES_IN=1d

# --- IA (Google Gemini) ---
# OBRIGATÓRIO: a API não inicia sem ela.
# Crie uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=troque_pela_sua_chave_do_google_ai_studio
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- Aplicação (uso local, fora do Docker) ---
# No Docker, PORT e CORS_ORIGIN são definidos no docker-compose.yaml.
PORT=3333
CORS_ORIGIN=http://localhost:3000
